local function create(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    for _, child in ipairs(children or {}) do child.Parent = obj end
    return obj
end

local function corner(r) return create("UICorner", {CornerRadius = UDim.new(0, r or 8)}) end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.2, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function label(props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or FONT
    props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
    local l = create("TextLabel", props)
    create("UIStroke", {Thickness = 1.6, Color = OUT, Parent = l})
    return l
end

local function bevel(props, top, bot, lip, radius, depth)
    depth = depth or 5
    local outer = create("Frame", {Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint, LayoutOrder = props.LayoutOrder or 0, BackgroundColor3 = lip, BorderSizePixel = 0, Parent = props.Parent}, {corner(radius or 8), create("UIStroke", {Thickness = 3, Color = OUT})})
    local face = create("Frame", {Size = UDim2.new(1, 0, 1, -depth), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = outer}, {corner(radius or 8)})
    local grad = create("UIGradient", {Color = ColorSequence.new(top, bot), Rotation = 90, Parent = face})
    return outer, face, grad
end

