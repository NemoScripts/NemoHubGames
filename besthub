local function applySearch()
    if not currentTab then return end
    local q = string.lower(SearchBox.Text)
    for _, r in ipairs(rowsByPage[currentTab.Page] or {}) do
        r.Frame.Visible = (q == "" or string.find(string.lower(r.Name), q, 1, true) ~= nil)
    end
end
connect(SearchBox:GetPropertyChangedSignal("Text"), applySearch)

local function selectTab(tab, instant)
    if currentTab == tab then return end
    currentTab = tab
    for _, t in ipairs(tabs) do 
        t.Group.Visible = false
        styleTab(t) 
    end
    SearchBox.Text = ""
    applySearch()
    tab.Group.Position = UDim2.fromOffset(0, instant and 0 or 16)
    tab.Group.GroupTransparency = instant and 0 or 1
    tab.Group.Visible = true
    if not instant then
        tween(tab.Group, {Position = UDim2.fromOffset(0, 0), GroupTransparency = 0}, 0.3, Enum.EasingStyle.Quint)
        press(tab.Face)
    end
end

