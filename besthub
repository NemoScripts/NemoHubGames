local function isFiniteNumber(v) return typeof(v) == "number" and v == v and v > -math.huge and v < math.huge end
local function isValidPosition(p) return typeof(p) == "Vector3" and isFiniteNumber(p.X) and isFiniteNumber(p.Y) and isFiniteNumber(p.Z) end

local function getCharacter()
    Character = LocalPlayer.Character
    if not Character then 
        RootPart = nil 
        return nil 
    end
    RootPart = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso")
    return Character
end
