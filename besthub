        else
            bGrad.Color = ColorSequence.new(SLATE_TOP, SLATE_BOT)
            bOuter.BackgroundColor3 = SLATE_LIP
            bLabel.Text = "OFF"
        end
        if callback and not silent then task.spawn(callback, state) end
    end
    local hit = create("TextButton", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = outer})
    connect(hit.Activated, function() press(bFace); set(not state) end)
    set(default or false, true)
    table.insert(rowsByPage[page], {Frame = outer, Name = name})
    return {Set = set}
end

local function addButton(page, name, callback, red)
    local top, bot, lip = GREEN_TOP, GREEN_BOT, GREEN_LIP
    if red then top, bot, lip = RED_TOP, RED_BOT, RED_LIP end
